<h1>Uploaded Documents</h1>
<%= link_to "New", new_document_path %>
<table>
  <thead>
    <th>Name</th>
    <th>Stuff<th>
  </thead>
  <tbody>
    <% @documents.each do |document| %>
    <tr>
      <td><%= document.name %></td>
      <td>
        <%= link_to 'Download', rails_blob_path(document.file, disposition: 'attachment') %>
        <%= link_to 'Edit', document_path(document.id) %>  
      </td>
    </tr>
    <% end %>
  </tbody>
</table>