<%= form_with model: @document, url: documents_path, method: :post, local: true, multipart: true do |form| %>
  <p>
    <%= form.label :name %><br>
    <%= form.text_field :name %>
  </p>
  <p>
    <%= form.label :file %><br>
    <%= form.file_field :file %>
  </p>
  <p>
    <%= form.submit 'Upload & Convert' %>
  </p>
<% end %>

